{
  "name": "yatt-ts",
  "version": "0.1.0",
  "description": "Highly configurable YATT MCP server library: spin up your own UI-testing MCP server (35 tools, Playwright engine, headless-first) with strict, typed configuration for paths, HTTP transport, auth, permissions, sessions and retention.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "yatt",
    "testing",
    "e2e",
    "browser-automation",
    "playwright",
    "ui-testing",
    "test-runner",
    "headless"
  ],
  "author": {
    "name": "José Valentino",
    "email": "josval.personal@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josvaal/yatt-ts.git"
  },
  "bugs": {
    "url": "https://github.com/josvaal/yatt-ts/issues"
  },
  "homepage": "https://github.com/josvaal/yatt-ts#readme",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "yatt-ts": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-bin-executable.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "express": "^4.22.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
