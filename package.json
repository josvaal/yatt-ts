{
  "name": "yatt-ts",
  "version": "0.1.0",
  "description": "Highly configurable YATT MCP server library: spin up your own UI-testing MCP server (35 tools, Playwright engine, headless-first) with strict, typed configuration for paths, HTTP transport, auth, permissions, sessions and retention.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "yatt-ts": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
